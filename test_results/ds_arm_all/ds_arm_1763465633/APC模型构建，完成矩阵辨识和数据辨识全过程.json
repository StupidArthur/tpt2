    {
      "id": "019a9719-c9bc-7822-8ea6-5dc03ca6ce0b",
      "type": "view",
      "view": {
        "format": "card",
        "content": {
          "title": "思考结果",
          "type": "think",
          "description": "针对您的问题已找到解决方案",
          "details": "\n\n"
        }
