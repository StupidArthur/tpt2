          "details": "```python\n\ndef convert(input):\n    # 获取历史步骤的输出数据\n    id1_data = input.get('id1', {})\n    \n    # 从历史数据中提取工艺模型和参数配置\n    running_model = id1_data.get('running_model', '')\n    running_model_tags = id1_data.get('running_model_tags', [])\n    \n    # 从用户输入中提取关键参数\n    user_tagnames = [\n        {\"tagName\": \"703FI007A.PV\"},  # 进气化炉氧气流量\n        {\"tagName\": \"703FZT002A.PV\"},  # 进气化炉煤浆流量\n        {\"tagName\": \"YMB.C1\"},  # 氧煤比\n        {\"tagName\": \"703TI005A.PV\"},  # 喷嘴温度\n        {\"tagName\": \"PZT004A.PV\"},  # 喷嘴压力\n        {\"tagName\": \"703LI003A.PV\"},  # 激冷室液位\n        {\"tagName\": \"703LI009A.PV\"},  # 水洗塔液位\n        {\"tagName\": \"703FI010A1.PV\"},  # 急冷水流量\n        {\"tagName\": \"703PZT055A.PV\"},  # 水洗塔塔顶压力\n        {\"tagName\": \"703FI017A.PV\"}  # 水洗塔进料流量\n    ]\n    \n    # 组装输出数据\n    output = {\n        \"user_tagnames\": user_tagnames,\n        \"user_duration\": 0,  # 默认持续时间为0\n        \"loaded_snapshot\": \"\",  # 未加载工况\n        \"running_model_tags\": running_model_tags,\n        \"pre_tagsvalue\": []  # 第一次操作，无历史数据\n    }\n    \n    return output\n\n```"
