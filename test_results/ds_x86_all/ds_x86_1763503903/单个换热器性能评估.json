    {
      "id": "019a992a-8d05-73f3-a72e-a5fff602b246",
      "type": "view",
      "view": {
        "format": "card",
        "content": {
          "title": "思考结果",
          "type": "think",
          "description": "针对您的问题已找到解决方案",
          "details": "\n\n"
        }
      }
