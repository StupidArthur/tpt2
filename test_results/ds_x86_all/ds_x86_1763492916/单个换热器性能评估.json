    {
      "id": "019a9883-20d9-7da2-9f69-484fc29871b4",
      "type": "view",
      "view": {
        "format": "card",
        "content": {
          "title": "思考结果",
          "type": "think",
          "description": "针对您的问题已找到解决方案",
          "details": "\n\n"
        }
      }
